PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/greenfarm?replicaSet=rs0
# Database to use; overrides any name in MONGODB_URI. Without either, MongoDB uses "test".
MONGODB_DB_NAME=fruit-db
# Signs the sign-in tokens (at least 32 random characters). Each account type gets its own key derived from it,
# unless you set separate secrets below.
JWT_SECRET_KEY=
JWT_CUSTOMER_SECRET=
JWT_ADMIN_SECRET=
JWT_PARTNER_SECRET=
CLIENT_ORIGIN=http://localhost:5174,http://localhost:5175
# The storefront's public address, for canonical links, sharing tags and the sitemap (defaults to the first CLIENT_ORIGIN).
PUBLIC_SITE_URL=
# Optional: serve the built storefront (e.g. ../frontend/dist) with each page's metadata in the HTML and real 404s.
STOREFRONT_DIST=
NODE_ENV=development
# lax when the storefront and API are on the same site; none only for cross-site hosting (needs HTTPS).
COOKIE_SAME_SITE=lax
# Optional, e.g. .greenfarm.com to share the sign-in cookies between www. and api. subdomains.
COOKIE_DOMAIN=
# Number of proxies in front of the API (e.g. 1 on Render, Railway or behind Nginx); empty when there is none.
TRUST_PROXY=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_SECRET_KEY=

# Static admin login; not stored in MongoDB. Password must be at least 8 characters.
ADMIN_EMAIL=
ADMIN_PSD=
